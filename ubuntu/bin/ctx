#!/bin/bash
if [ -z "$1" ]; then
    echo "Usage: ctx <filename>" >&2
    exit 1
fi

file="$1"
if [ ! -f "$file" ]; then
    echo "Error: File '$file' does not exist." >&2
    exit 1
fi

ext="${file##*.}"
{
    echo "\`\`\`$ext"
    cat "$file"
    echo -e "\n\`\`\`"
} | /usr/local/bin/termux-clipboard-set

echo "Copied '$file' to Android clipboard."
